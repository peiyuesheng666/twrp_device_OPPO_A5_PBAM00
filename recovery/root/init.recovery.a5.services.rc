# SPDX-License-Identifier: Apache-2.0
# Stock A.35 service payloads; isolated stock linker and dependency closure.
on post-fs
    wait /dev/block/bootdevice/by-name/modem 5
    mount vfat /dev/block/bootdevice/by-name/modem /firmware ro
    start hwservicemanager
    start a5-qseecomd
    start a5-keymaster-3-0

service hwservicemanager /sbin/a5-stock/hwservicemanager
    user root
    group root system readproc
    disabled
    setenv LD_LIBRARY_PATH /sbin/a5-stock
    seclabel u:r:recovery:s0
    onrestart setprop hwservicemanager.ready false

service a5-qseecomd /sbin/a5-stock/qseecomd
    user root
    group root system drmrpc
    disabled
    setenv LD_LIBRARY_PATH /sbin/a5-stock
    seclabel u:r:recovery:s0

service a5-keymaster-3-0 /sbin/a5-stock/android.hardware.keymaster@3.0-service-qti
    user root
    group root system drmrpc
    disabled
    setenv LD_LIBRARY_PATH /sbin/a5-stock
    seclabel u:r:recovery:s0
